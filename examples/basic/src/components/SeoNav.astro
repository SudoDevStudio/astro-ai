---
const { pathname } = Astro.url;

const fixtures = [
	{ href: '/seo/', label: 'Overview', state: '1 warning' },
	{ href: '/seo/clean/', label: 'Clean', state: 'no issues' },
	{ href: '/seo/rich/', label: 'Rich result', state: 'no issues' },
	{ href: '/seo/broken/', label: 'Broken', state: 'errors' },
	{ href: '/seo/minimal/', label: 'Bare head', state: 'errors' },
];
---

<nav class="fixtures" aria-label="Share preview fixtures">
	{
		fixtures.map(({ href, label, state }) => (
			<a href={href} aria-current={pathname === href ? 'page' : undefined}>
				<strong>{label}</strong>
				<span>{state}</span>
			</a>
		))
	}
</nav>

<style>
	.fixtures {
		display: grid;
		gap: 0.5rem;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
	}

	.fixtures a {
		border: 1px solid #262b35;
		border-radius: 8px;
		color: inherit;
		display: grid;
		gap: 0.15rem;
		padding: 0.6rem 0.8rem;
		text-decoration: none;
	}

	.fixtures a:hover {
		border-color: #3f4552;
	}

	.fixtures a[aria-current='page'] {
		background: #1b1630;
		border-color: #6d4bb0;
	}

	strong {
		font-size: 0.95rem;
	}

	span {
		color: #aeb6c5;
		font-size: 0.8rem;
	}
</style>
