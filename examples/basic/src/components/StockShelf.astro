---
import { getJson } from '../lib/perf-api';

const [inventory, prices] = await Promise.all([
	getJson<{ inStock: number; warehouses: number }>('/api/perf/inventory.json', Astro.url),
	getJson<{ currency: string; from: string }>('/api/perf/prices.json', Astro.url),
]);
---

<section class="panel">
	<h2>Stock and pricing</h2>
	<p>
		{inventory === undefined ? 'Stock unavailable' : `${inventory.inStock} items across ${inventory.warehouses} warehouses`}
	</p>
	<p>{prices === undefined ? 'Prices unavailable' : `From ${prices.currency} ${prices.from}`}</p>
</section>

<style>
	.panel {
		border: 1px solid #343a46;
		border-radius: 8px;
		padding: 1rem 1.25rem;
	}

	h2 {
		font-size: 1.05rem;
		margin: 0 0 0.5rem;
	}

	p {
		margin: 0.2rem 0;
	}
</style>
