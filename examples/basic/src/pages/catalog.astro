---
import Layout from '../layouts/Layout.astro';
import Callout from '../components/Callout.astro';

// The realistic shape: one source node rendered in a loop, where every rendered
// instance carries a different entry id.
const products = [
	{ id: 'entry-a17c', sku: 'SKU-1001', name: 'Torque wrench', blurb: 'Calibrated to 200 Nm.' },
	{ id: 'entry-c23f', sku: 'SKU-1002', name: 'Cable spool', blurb: 'Shielded, 100 m.' },
	{ id: 'entry-d95b', sku: 'SKU-1003', name: 'Safety harness', blurb: 'Full body, size L.' },
];

const description =
	'One template rendered in a loop, where every card resolves its own CMS entry from the element you clicked while the source location stays put.';

const origin = Astro.site ?? Astro.url.origin;
const url = new URL('/catalog/', origin).href;

// Passing `schema` replaces the auto blocks, so the page and organisation are
// restated here with the same values the tags use. The list is built from the
// same `products` the cards render, so every declared fact is visible on the page.
const schema = [
	{
		'@context': 'https://schema.org',
		'@type': 'CollectionPage',
		name: 'Catalog · astro-ai example',
		url,
		description,
		image: new URL('/og/card.png', origin).href,
		mainEntity: {
			'@type': 'ItemList',
			name: 'Product cards',
			numberOfItems: products.length,
			itemListElement: products.map((product, index) => ({
				'@type': 'ListItem',
				position: index + 1,
				item: {
					'@type': 'Product',
					name: product.name,
					sku: product.sku,
					description: product.blurb,
				},
			})),
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Organization',
		name: 'astro-ai example',
		url: new URL('/', origin).href,
		logo: new URL('/favicon.svg', origin).href,
		sameAs: ['https://github.com/SudoDevStudio/astro-ai'],
	},
];
---

<Layout
	title="Catalog"
	lede="One template, many entries. Each rendered card resolves its own entry."
	seo={{
		description,
		image: '/og/card.png',
		imageAlt: 'Abstract share card for the astro-ai example',
		schema,
	}}
>
	<Callout title="What to try" tone="accent">
		Select the name on the first card, then the second. The source file and line
		stay the same because all three cards come from one template, but the
		resolved entry changes with the card you clicked.
	</Callout>

	<section class="grid" aria-label="Product cards">
		{
			products.map((product) => (
				<article class="card" data-entry-id={product.id} data-sku={product.sku}>
					<h2>{product.name}</h2>
					<p>{product.blurb}</p>
					<p class="sku">{product.sku}</p>
				</article>
			))
		}
	</section>

	<section class="panel" aria-label="How the cards are built">
		<h2>How the cards are built</h2>
		<p>
			All three cards come from one <code>products.map()</code> call, fed by a
			local array that stands in for a CMS response. Each card carries a
			<code>data-entry-id</code> for its record and a <code>data-sku</code> for
			its catalog number, so the torque wrench, cable spool, and safety harness
			each resolve to a different entry.
		</p>
		<p>
			Changing the card markup, such as the heading or the SKU styling, is a
			template edit and updates every card at once. Changing a product's name or
			description is a content edit, and it belongs in that product's entry
			rather than in the template.
		</p>
	</section>

	<Callout title="Why this matters">
		A node id identifies a source location, not a DOM node. The entry id is read
		from the element you actually clicked, so a loop of CMS records stays
		distinguishable even though one edit to the template affects them all.
	</Callout>
</Layout>

<style>
	.grid {
		display: grid;
		gap: 0.75rem;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
	}

	.card {
		border: 1px solid #14805e;
		border-radius: 8px;
		display: grid;
		gap: 0.3rem;
		padding: 1rem;
	}

	h2 {
		font-size: 1rem;
		margin: 0;
	}

	p {
		margin: 0;
	}

	.sku {
		color: #86efac;
		font-family: ui-monospace, SFMono-Regular, monospace;
		font-size: 0.8rem;
	}

	.panel {
		border: 1px dashed #3f4552;
		border-radius: 8px;
		display: grid;
		gap: 0.5rem;
		padding: 1rem 1.25rem;
	}

	code {
		color: #86efac;
	}
</style>
