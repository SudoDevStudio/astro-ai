---
import Layout from '../layouts/Layout.astro';
import Callout from '../components/Callout.astro';
import RestockNotice from '../components/RestockNotice.astro';
import ReviewSummary from '../components/ReviewSummary.astro';
import StockShelf from '../components/StockShelf.astro';
import { getJson } from '../lib/perf-api';

// The page fetches categories for its own heading, and ReviewSummary fetches
// them again below.
const categories = await getJson<string[]>('/api/perf/categories.json', Astro.url);
---

<Layout
	title="Performance"
	lede="Open the Build with AI app: every section is outlined with its render time and the calls it made."
	seo={{
		description:
			'Sections with slow, sequential, duplicated and failing server fetches, and an image that is the page’s largest paint, for the Perf panel to rank.',
		image: '/og/card.png',
		imageAlt: 'Abstract share card for the astro-ai example',
	}}
>
	<Callout title="What to try" tone="accent">
		Open the Build with AI app. Stock and pricing is outlined in red: its two
		calls are awaited one after the other. Reviews makes a call the page makes
		too, the restock line's call answers 404, and the large image is the
		page's Largest Contentful Paint, lazy-loaded with no size declared. Click
		a card's header for its findings. Ask AI on the corner card opens the chat
		with the problems already written out; the Perf button in the chat window
		hides the outlines.
	</Callout>

	<!--
		Deliberately unoptimised: lazy-loaded although it is the largest paint,
		no width or height, so it shifts the content below when it arrives.
	-->
	<img class="hero" src="/og/card.png" alt="Abstract banner" loading="lazy" />

	<p class="categories">
		{categories === undefined ? 'Browse the catalog' : `Browse ${categories.join(' · ')}`}
	</p>

	<div class="grid">
		<StockShelf />
		<ReviewSummary />
	</div>

	<RestockNotice />
</Layout>

<style>
	.hero {
		border-radius: 10px;
		display: block;
		width: 100%;
	}

	.categories {
		color: #c4b5fd;
		margin: 0;
	}

	.grid {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
	}
</style>
