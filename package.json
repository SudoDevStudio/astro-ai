{
  "name": "@sudodevstudio/astro-ai",
  "version": "1.0.0",
  "description": "Development-only Build with AI tooling for Astro projects.",
  "license": "MIT",
  "author": "Maninderpreet Singh",
  "homepage": "https://github.com/SudoDevStudio/astro-ai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SudoDevStudio/astro-ai.git"
  },
  "bugs": {
    "url": "https://github.com/SudoDevStudio/astro-ai/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "astro-integration",
    "astro-component",
    "withastro",
    "astro",
    "visual-editor",
    "devtools",
    "vite",
    "codex",
    "claude",
    "development-tools"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/integration/index.d.ts",
      "import": "./dist/integration/index.js"
    },
    "./protocol": {
      "types": "./dist/shared/protocol.d.ts",
      "import": "./dist/shared/protocol.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "format:check": "prettier --check src/agent/cli-agent-fallback.ts",
    "test": "npm run test:unit",
    "test:all": "npm run test:unit && npm run test:hmr && npm run test:production",
    "test:unit": "npm run build && node --test test/*.test.mjs",
    "test:hmr": "node test/run-live-tests.mjs",
    "test:production": "node test/verify-production.mjs",
    "smoke:hmr": "node test/live-hmr-smoke.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@astrojs/compiler-rs": "^0.4.0",
    "@babel/parser": "^7.29.8",
    "magic-string": "^1.0.0"
  },
  "peerDependencies": {
    "astro": ">=7.0.0 <8.0.0",
    "vite": ">=7.0.0 <9.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "astro": "^7.2.9",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  },
  "sideEffects": false
}
