{
  "name": "astro-ai",
  "version": "0.0.1",
  "description": "Development-only Build with AI tooling for Astro projects.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/integration/index.d.ts",
      "import": "./dist/integration/index.js"
    },
    "./protocol": {
      "types": "./dist/shared/protocol.d.ts",
      "import": "./dist/shared/protocol.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "smoke:hmr": "node test/live-hmr-smoke.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@astrojs/compiler-rs": "^0.4.0",
    "@babel/parser": "^7.29.8",
    "magic-string": "^1.0.0"
  },
  "peerDependencies": {
    "astro": ">=7.0.0 <8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "astro": "^7.2.9",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  },
  "sideEffects": false
}
